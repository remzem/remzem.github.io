<aside class="infobox">
  {% if infobox.image %}
    <img src="{{ infobox.image }}" alt="{{ title }}">
  {% endif %}
  <h2>{{ title }}</h2>
  <table>
    {% for field in infobox.fields %}
      <tr>
        <th>{{ field.label }}</th>
        <td>{{ field.value }}</td>
      </tr>
    {% endfor %}
  </table>
</aside>
